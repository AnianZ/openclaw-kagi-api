{
  "name": "openclaw-kagi-api",
  "version": "1.0.2",
  "description": "Kagi Search API provider for OpenClaw",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "kagi",
    "web-search",
    "search-api",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AnianZ/openclaw-kagi-api.git"
  },
  "bugs": {
    "url": "https://github.com/AnianZ/openclaw-kagi-api/issues"
  },
  "homepage": "https://github.com/AnianZ/openclaw-kagi-api#readme",
  "author": "AnianZ",
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.8"
  },
  "devDependencies": {
    "openclaw": "2026.9.8",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.8",
      "minGatewayVersion": "2026.9.8"
    },
    "build": {
      "openclawVersion": "2026.9.8",
      "pluginSdkVersion": "2026.9.8"
    }
  }
}
